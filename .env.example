# ===========================================
# ASTEYA - Environment Configuration
# ===========================================
# IMPORTANT: Never commit real credentials to version control.
# Copy this file to .env and fill in your actual values.

# ===========================================
# AI Services
# ===========================================

# Google Gemini API (for AI features)
# Get your key from: https://aistudio.google.com/apikey
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# NVIDIA NIM API (alternative AI backend)
# Get your key from: https://build.nvidia.com/
NVIDIA_API_KEY="nvapi-YOUR_NVIDIA_API_KEY"

# ===========================================
# Application Configuration
# ===========================================

# Your app's URL (for callbacks and API endpoints)
APP_URL="http://localhost:3000"

# ===========================================
# Database (Supabase)
# ===========================================

# Supabase project URL
VITE_SUPABASE_URL="https://your-project.supabase.co"

# Supabase Anon Key (public, but scope it properly)
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"

# ===========================================
# Authentication (Clerk)
# ===========================================

# Clerk Publishable Key (public key)
VITE_CLERK_PUBLISHABLE_KEY="pk_test_xxxxx"

# ===========================================
# Email Service (SMTP via Nodemailer)
# ===========================================

# For Gmail: Use an App Password, not your main password
# Go to: https://myaccount.google.com/apppasswords
SMTP_USER="your-email@gmail.com"
SMTP_PASS="YOUR_GMAIL_APP_PASSWORD"

# ===========================================
# Security Configuration
# ===========================================

# Allowed CORS origins (comma-separated)
# Add your production domain(s) here
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173"

# ===========================================
# Admin Configuration (Optional)
# ===========================================

# Override or extend admin emails via environment
# Format: comma-separated email addresses
# ASTEYA_ADMIN_EMAILS="admin@asteya.com,your-email@gmail.com"